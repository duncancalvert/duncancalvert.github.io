{% if site.enable_fingerprint_collector %}
  <!-- Device Fingerprint Collector -->
  <script src="{{ site.fingerprint_collector_url }}/static/collector.js"></script>
  <script>
    FP.init({
      siteId: '{{ site.fingerprint_site_id }}',
      collectorUrl: '{{ site.fingerprint_collector_url }}',
    });
  </script>
{% endif %}
